<svg id="hifi-portfolio-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1400 4600" width="100%" height="auto" style="background-color: #FFFFFF;">
                    
                    <!-- SVG Definitions & Styles -->
                    <defs>
                        <!-- Linear Gradients -->
                        <linearGradient id="lime-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#a8c047"/>
                            <stop offset="100%" stop-color="#849a2e"/>
                        </linearGradient>

                        <linearGradient id="dark-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#222222"/>
                            <stop offset="100%" stop-color="#111111"/>
                        </linearGradient>

                        <linearGradient id="card-grad-light" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#ffffff"/>
                            <stop offset="100%" stop-color="#eef5d0"/>
                        </linearGradient>

                        <linearGradient id="card-grad-dark" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#8ba832"/>
                            <stop offset="100%" stop-color="#a8c047"/>
                        </linearGradient>

                        <!-- Box Shadows -->
                        <filter id="soft-shadow" x="-10%" y="-10%" width="130%" height="130%">
                            <feDropShadow dx="0" dy="12" stdDeviation="15" flood-color="#000000" flood-opacity="0.08"/>
                        </filter>
                        
                        <filter id="glow-shadow" x="-20%" y="-20%" width="140%" height="140%">
                            <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#a8c047" flood-opacity="0.3"/>
                        </filter>

                        <!-- Typography & Style Classes -->
                        <style>
                            @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&amp;family=Space+Mono:wght@400;700&amp;family=Archivo+Black&amp;display=swap');
                            
                            .hf-title { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 800; fill: #222222; }
                            .hf-subtitle { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 700; fill: #7d8f2f; }
                            .hf-body { font-family: 'Plus Jakarta Sans', sans-serif; font-weight: 400; fill: #444444; line-height: 1.6; }
                            .hf-mono { font-family: 'Space Mono', monospace; }
                            .hf-archivo { font-family: 'Archivo Black', sans-serif; }
                            
                            .hf-card { fill: #FFFFFF; filter: url(#soft-shadow); rx: 20px; }
                            .hf-card-bg { fill: #f5f6ee; rx: 25px; }
                            .hf-tag { fill: #FFFFFF; stroke: #a8c047; stroke-width: 1.5; rx: 8px; }
                            .hf-tag-text { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 700; fill: #556b1e; }
                            
                            .hf-[#a8c047] { fill: #a8c047; }
                            .hf-[#849a2e] { fill: #849a2e; }
                            .hf-dark { fill: #222222; }
                        </style>
                    </defs>

                    <!-- Background Base Canvas -->
                    <rect width="1400" height="4600" fill="#FFFFFF"/>

                    <!-- ==========================================
                         1. TOP MARQUEE TICKER BAR
                         ========================================== -->
                    <g id="hifi-top-bar">
                        <rect x="0" y="0" width="1400" height="40" fill="url(#lime-grad)"/>
                        <text x="700" y="25" text-anchor="middle" fill="#222222" class="hf-mono" font-weight="700" font-size="13">
                            Backend ★ Frontend ★ Database ★ Testing ★ HTML ★ CSS ★ JavaScript ★ React ★ C# ★ ASP.NET ★ PHP ★ Laravel ★ MySQL ★ PostgreSQL ★ MongoDB ★ Quality Assurance
                        </text>
                    </g>

                    <!-- ==========================================
                         2. NAVBAR
                         ========================================== -->
                    <g id="hifi-navbar" transform="translate(0, 40)">
                        <rect x="0" y="0" width="1400" height="85" fill="#FFFFFF" filter="url(#soft-shadow)"/>
                        
                        <!-- Logo -->
                        <text x="80" y="52" class="hf-title" font-size="24">Mo Al-Tarifi</text>
                        <circle cx="215" cy="46" r="4" fill="#a8c047"/>

                        <!-- Menu Links -->
                        <g transform="translate(620, 32)">
                            <text x="0" y="20" class="hf-title" font-size="15" fill="#222222">About</text>
                            <text x="80" y="20" class="hf-title" font-size="15" fill="#222222">Results</text>
                            <text x="170" y="20" class="hf-title" font-size="15" fill="#222222">Stack</text>
                            <text x="245" y="20" class="hf-title" font-size="15" fill="#222222">Projects</text>
                            <text x="345" y="20" class="hf-title" font-size="15" fill="#222222">Certificates</text>
                            <text x="475" y="20" class="hf-title" font-size="15" fill="#222222">Work</text>
                            
                            <!-- Active Contact Button -->
                            <rect x="540" y="-5" width="110" height="40" rx="20" fill="url(#lime-grad)"/>
                            <text x="595" y="20" text-anchor="middle" class="hf-title" font-size="14" fill="#222222">Contact</text>
                        </g>
                    </g>

                    <!-- ==========================================
                         3. HERO / ABOUT SECTION
                         ========================================== -->
                    <g id="hifi-about" transform="translate(75, 175)">
                        <!-- Main Frame -->
                        <rect x="0" y="0" width="1250" height="600" class="hf-card-bg" filter="url(#soft-shadow)"/>
                        <line x1="625" y1="0" x2="625" y2="600" stroke="#a8c047" stroke-width="2"/>

                        <!-- Left Column (Content) -->
                        <g transform="translate(60, 60)">
                            <text x="0" y="45" class="hf-title" font-size="48" fill="#222222">Mohammad Al-Tarifi</text>
                            <text x="0" y="80" class="hf-subtitle" font-size="22">Software Engineer</text>
                            
                            <!-- Bullet Tagline -->
                            <text x="0" y="125" class="hf-title" font-size="18" fill="#a8c047">Building ideas. Writing code. Solving problems.</text>
                            
                            <!-- Paragraph -->
                            <text x="0" y="165" class="hf-body" font-size="15">I'm Mohammad Altarifi, a Software Engineer and graduate of World Islamic</text>
                            <text x="0" y="190" class="hf-body" font-size="15">Sciences &amp; Education University. I'm passionate about Web Development,</text>
                            <text x="0" y="215" class="hf-body" font-size="15">Software Engineering, and Quality Assurance. I enjoy turning ideas into</text>
                            <text x="0" y="240" class="hf-body" font-size="15">practical solutions through hands-on technical projects.</text>

                            <!-- Fields Sub-cards -->
                            <g transform="translate(0, 275)">
                                <text x="0" y="0" class="hf-title" font-size="16" fill="#7d8f2f">MY FIELDS:</text>
                                
                                <g transform="translate(0, 15)">
                                    <rect x="0" y="0" width="160" height="80" rx="12" fill="#FFFFFF" stroke="#a8c047" stroke-width="1.5"/>
                                    <text x="15" y="30" class="hf-title" font-size="13">Web Development</text>
                                    <text x="15" y="52" class="hf-body" font-size="11">Responsive Apps</text>

                                    <rect x="175" y="0" width="160" height="80" rx="12" fill="#FFFFFF" stroke="#a8c047" stroke-width="1.5"/>
                                    <text x="190" y="30" class="hf-title" font-size="13">Software Eng.</text>
                                    <text x="190" y="52" class="hf-body" font-size="11">Architecture &amp; Clean</text>

                                    <rect x="350" y="0" width="160" height="80" rx="12" fill="#FFFFFF" stroke="#a8c047" stroke-width="1.5"/>
                                    <text x="365" y="30" class="hf-title" font-size="13">Quality Assurance</text>
                                    <text x="365" y="52" class="hf-body" font-size="11">Testing &amp; Coverage</text>
                                </g>
                            </g>

                            <!-- Explore Button -->
                            <g transform="translate(0, 410)">
                                <rect x="0" y="0" width="220" height="50" rx="25" fill="url(#lime-grad)" filter="url(#glow-shadow)"/>
                                <text x="110" y="30" text-anchor="middle" class="hf-title" font-size="15" fill="#222222">Explore My Work ↓</text>
                            </g>
                        </g>

                        <!-- Right Column (Avatar & Shadow Card) -->
                        <g transform="translate(750, 90)">
                            <!-- Black Shadow Block -->
                            <rect x="25" y="25" width="320" height="420" rx="20" fill="#222222"/>
                            
                            <!-- Main Portrait Box -->
                            <rect x="0" y="0" width="320" height="420" rx="20" fill="#a8c047"/>
                            
                            <!-- Decorative Avatar Illustration -->
                            <rect x="20" y="20" width="280" height="380" rx="16" fill="#1D2939"/>
                            <circle cx="160" cy="170" r="70" fill="#a8c047"/>
                            <path d="M 70 340 C 70 250, 250 250, 250 340 Z" fill="#a8c047"/>
                            
                            <!-- Code Tag Accent -->
                            <rect x="40" y="330" width="240" height="45" rx="12" fill="#ffffff"/>
                            <text x="160" y="358" text-anchor="middle" class="hf-mono" font-weight="700" font-size="13" fill="#222222">&lt;SoftwareEngineer /&gt;</text>
                        </g>
                    </g>

                    <!-- ==========================================
                         4. RESULTS METRICS SECTION
                         ========================================== -->
                    <g id="hifi-results" transform="translate(75, 820)">
                        <rect x="0" y="0" width="1250" height="440" class="hf-card-bg" filter="url(#soft-shadow)"/>

                        <text x="60" y="65" class="hf-title" font-size="40">RESULTS</text>
                        <text x="60" y="95" class="hf-body" font-size="16">Measurable improvements through practical software &amp; QA work.</text>

                        <!-- 2x2 Grid -->
                        <g transform="translate(60, 130)">
                            
                            <!-- Metric Card 1 -->
                            <g transform="translate(0, 0)">
                                <rect x="0" y="0" width="540" height="110" rx="18" fill="#FFFFFF" filter="url(#soft-shadow)"/>
                                <rect x="0" y="0" width="8" height="110" rx="4" fill="#a8c047"/>
                                
                                <text x="35" y="45" class="hf-title" font-size="18">TEST COVERAGE</text>
                                <text x="35" y="72" class="hf-body" font-size="14">Better testing coverage</text>

                                <rect x="330" y="35" width="65" height="42" rx="8" fill="#E5E5E5"/>
                                <text x="362" y="62" text-anchor="middle" class="hf-title" font-size="16" fill="#777777" style="text-decoration: line-through;">12%</text>
                                
                                <text x="415" y="62" text-anchor="middle" font-size="22" fill="#555555">→</text>

                                <rect x="435" y="28" width="80" height="54" rx="12" fill="url(#lime-grad)" filter="url(#glow-shadow)"/>
                                <text x="475" y="62" text-anchor="middle" class="hf-title" font-size="22" fill="#222222">94%</text>
                            </g>

                            <!-- Metric Card 2 -->
                            <g transform="translate(590, 0)">
                                <rect x="0" y="0" width="540" height="110" rx="18" fill="#FFFFFF" filter="url(#soft-shadow)"/>
                                <rect x="0" y="0" width="8" height="110" rx="4" fill="#a8c047"/>
                                
                                <text x="35" y="45" class="hf-title" font-size="18">RELEASES PER MONTH</text>
                                <text x="35" y="72" class="hf-body" font-size="14">More frequent releases</text>

                                <rect x="350" y="35" width="45" height="42" rx="8" fill="#E5E5E5"/>
                                <text x="372" y="62" text-anchor="middle" class="hf-title" font-size="16" fill="#777777" style="text-decoration: line-through;">1</text>
                                
                                <text x="415" y="62" text-anchor="middle" font-size="22" fill="#555555">→</text>

                                <rect x="435" y="28" width="80" height="54" rx="12" fill="url(#lime-grad)" filter="url(#glow-shadow)"/>
                                <text x="475" y="62" text-anchor="middle" class="hf-title" font-size="22" fill="#222222">8</text>
                            </g>

                            <!-- Metric Card 3 -->
                            <g transform="translate(0, 140)">
                                <rect x="0" y="0" width="540" height="110" rx="18" fill="#FFFFFF" filter="url(#soft-shadow)"/>
                                <rect x="0" y="0" width="8" height="110" rx="4" fill="#a8c047"/>
                                
                                <text x="35" y="45" class="hf-title" font-size="18">PROD BUGS / MONTH</text>
                                <text x="35" y="72" class="hf-body" font-size="14">Fewer production bugs</text>

                                <rect x="330" y="35" width="65" height="42" rx="8" fill="#E5E5E5"/>
                                <text x="362" y="62" text-anchor="middle" class="hf-title" font-size="16" fill="#777777" style="text-decoration: line-through;">47</text>
                                
                                <text x="415" y="62" text-anchor="middle" font-size="22" fill="#555555">→</text>

                                <rect x="435" y="28" width="80" height="54" rx="12" fill="url(#lime-grad)" filter="url(#glow-shadow)"/>
                                <text x="475" y="62" text-anchor="middle" class="hf-title" font-size="22" fill="#222222">3</text>
                            </g>

                            <!-- Metric Card 4 -->
                            <g transform="translate(590, 140)">
                                <rect x="0" y="0" width="540" height="110" rx="18" fill="#FFFFFF" filter="url(#soft-shadow)"/>
                                <rect x="0" y="0" width="8" height="110" rx="4" fill="#a8c047"/>
                                
                                <text x="35" y="45" class="hf-title" font-size="18">PAGE LOAD TIME</text>
                                <text x="35" y="72" class="hf-body" font-size="14">Faster page loading</text>

                                <rect x="325" y="35" width="70" height="42" rx="8" fill="#E5E5E5"/>
                                <text x="360" y="62" text-anchor="middle" class="hf-title" font-size="16" fill="#777777" style="text-decoration: line-through;">4.8s</text>
                                
                                <text x="415" y="62" text-anchor="middle" font-size="22" fill="#555555">→</text>

                                <rect x="435" y="28" width="80" height="54" rx="12" fill="url(#lime-grad)" filter="url(#glow-shadow)"/>
                                <text x="475" y="62" text-anchor="middle" class="hf-title" font-size="22" fill="#222222">0.9s</text>
                            </g>
                        </g>
                    </g>

                    <!-- ==========================================
                         5. MARKETING BOLD TYPOGRAPHY BLOCK
                         ========================================== -->
                    <g id="hifi-marketing" transform="translate(0, 1310)">
                        <rect x="0" y="0" width="1400" height="380" fill="#a8c047"/>

                        <g transform="translate(250, 50)">
                            <text x="0" y="45" fill="#FFFFFF" class="hf-archivo" font-size="64">I BUILD</text>

                            <rect x="250" y="5" width="220" height="52" fill="#d4ff3f"/>
                            <text x="265" y="46" fill="#000000" class="hf-archivo" font-size="52">FRONT.</text>

                            <text x="0" y="105" fill="#FFFFFF" class="hf-archivo" font-size="64">I BUILD</text>

                            <rect x="250" y="65" width="180" height="52" fill="#9eff91"/>
                            <text x="265" y="106" fill="#000000" class="hf-archivo" font-size="52">BACK</text>

                            <text x="0" y="165" fill="#FFFFFF" class="hf-archivo" font-size="64">I TEST</text>

                            <rect x="210" y="125" width="410" height="52" fill="#ffd600"/>
                            <text x="225" y="166" fill="#000000" class="hf-archivo" font-size="52">EVERYTHING.</text>

                            <!-- Paragraph -->
                            <g transform="translate(0, 210)">
                                <text x="0" y="20" fill="#222222" class="hf-mono" font-size="14">One person instead of a distributed team: interface, API, database,</text>
                                <text x="0" y="40" fill="#222222" class="hf-mono" font-size="14">pipeline and tests – in a single pair of hands. Nothing gets lost between</text>
                                <text x="0" y="60" fill="#222222" class="hf-mono" font-size="14">departments, because there are no departments.</text>
                            </g>
                        </g>
                    </g>

                    <!-- ==========================================
                         6. TECH STACK MATRIX
                         ========================================== -->
                    <g id="hifi-stack" transform="translate(75, 1740)">
                        <rect x="0" y="0" width="1250" height="520" rx="20" fill="none" stroke="#a8c047" stroke-width="2"/>

                        <!-- 2x2 Quadrant Grid -->
                        <g transform="translate(0, 0)">
                            
                            <!-- Top Left: Frontend -->
                            <g transform="translate(0, 0)">
                                <rect x="0" y="0" width="625" height="260" rx="20" fill="url(#card-grad-dark)"/>
                                <text x="40" y="50" class="hf-title" font-size="22" fill="#FFFFFF">FRONTEND</text>
                                <line x1="40" y1="65" x2="585" y2="65" stroke="#FFFFFF" stroke-opacity="0.4" stroke-dasharray="4 4" stroke-width="2"/>
                                
                                <text x="40" y="95" class="hf-body" font-size="14" fill="#FFFFFF">Building responsive and accessible interfaces with clean structure</text>
                                <text x="40" y="115" class="hf-body" font-size="14" fill="#FFFFFF">and practical user experiences.</text>

                                <g transform="translate(40, 160)">
                                    <rect x="0" y="0" width="75" height="34" class="hf-tag"/>
                                    <text x="37" y="22" text-anchor="middle" class="hf-tag-text">HTML</text>

                                    <rect x="85" y="0" width="65" height="34" class="hf-tag"/>
                                    <text x="117" y="22" text-anchor="middle" class="hf-tag-text">CSS</text>

                                    <rect x="160" y="0" width="110" height="34" class="hf-tag"/>
                                    <text x="215" y="22" text-anchor="middle" class="hf-tag-text">JavaScript</text>

                                    <rect x="280" y="0" width="75" height="34" class="hf-tag"/>
                                    <text x="317" y="22" text-anchor="middle" class="hf-tag-text">React</text>
                                </g>
                            </g>

                            <!-- Top Right: Backend -->
                            <g transform="translate(625, 0)">
                                <rect x="0" y="0" width="625" height="260" rx="20" fill="url(#card-grad-light)"/>
                                <text x="40" y="50" class="hf-title" font-size="22" fill="#222222">BACKEND</text>
                                <line x1="40" y1="65" x2="585" y2="65" stroke="#222222" stroke-opacity="0.2" stroke-dasharray="4 4" stroke-width="2"/>

                                <text x="40" y="95" class="hf-body" font-size="14">Building web applications, APIs and database-driven solutions.</text>

                                <g transform="translate(40, 160)">
                                    <rect x="0" y="0" width="55" height="34" class="hf-tag"/>
                                    <text x="27" y="22" text-anchor="middle" class="hf-tag-text">C#</text>

                                    <rect x="65" y="0" width="100" height="34" class="hf-tag"/>
                                    <text x="115" y="22" text-anchor="middle" class="hf-tag-text">ASP.NET</text>

                                    <rect x="175" y="0" width="65" height="34" class="hf-tag"/>
                                    <text x="207" y="22" text-anchor="middle" class="hf-tag-text">PHP</text>

                                    <rect x="250" y="0" width="90" height="34" class="hf-tag"/>
                                    <text x="295" y="22" text-anchor="middle" class="hf-tag-text">LARAVEL</text>
                                </g>
                            </g>

                            <!-- Bottom Left: QA -->
                            <g transform="translate(0, 260)">
                                <rect x="0" y="0" width="625" height="260" rx="20" fill="url(#card-grad-light)"/>
                                <text x="40" y="50" class="hf-title" font-size="22" fill="#222222">QUALITY ASSURANCE</text>
                                <line x1="40" y1="65" x2="585" y2="65" stroke="#222222" stroke-opacity="0.2" stroke-dasharray="4 4" stroke-width="2"/>

                                <text x="40" y="95" class="hf-body" font-size="14">Testing software to find issues early and improve reliability and quality.</text>

                                <g transform="translate(40, 160)">
                                    <rect x="0" y="0" width="130" height="34" class="hf-tag"/>
                                    <text x="65" y="22" text-anchor="middle" class="hf-tag-text">Manual Testing</text>

                                    <rect x="140" y="0" width="100" height="34" class="hf-tag"/>
                                    <text x="190" y="22" text-anchor="middle" class="hf-tag-text">Test Cases</text>

                                    <rect x="250" y="0" width="120" height="34" class="hf-tag"/>
                                    <text x="310" y="22" text-anchor="middle" class="hf-tag-text">Bug Reporting</text>
                                </g>
                            </g>

                            <!-- Bottom Right: Database -->
                            <g transform="translate(625, 260)">
                                <rect x="0" y="0" width="625" height="260" rx="20" fill="url(#card-grad-dark)"/>
                                <text x="40" y="50" class="hf-title" font-size="22" fill="#FFFFFF">DATABASE</text>
                                <line x1="40" y1="65" x2="585" y2="65" stroke="#FFFFFF" stroke-opacity="0.4" stroke-dasharray="4 4" stroke-width="2"/>

                                <text x="40" y="95" class="hf-body" font-size="14" fill="#FFFFFF">Working with structured and NoSQL data for practical applications.</text>

                                <g transform="translate(40, 160)">
                                    <rect x="0" y="0" width="65" height="34" class="hf-tag"/>
                                    <text x="32" y="22" text-anchor="middle" class="hf-tag-text">SQL</text>

                                    <rect x="75" y="0" width="80" height="34" class="hf-tag"/>
                                    <text x="115" y="22" text-anchor="middle" class="hf-tag-text">MySQL</text>

                                    <rect x="165" y="0" width="110" height="34" class="hf-tag"/>
                                    <text x="220" y="22" text-anchor="middle" class="hf-tag-text">PostgreSQL</text>

                                    <rect x="285" y="0" width="95" height="34" class="hf-tag"/>
                                    <text x="332" y="22" text-anchor="middle" class="hf-tag-text">MongoDB</text>
                                </g>
                            </g>
                        </g>
                    </g>

                    <!-- ==========================================
                         7. SELECTED PROJECTS SHOWCASE
                         ========================================== -->
                    <g id="hifi-projects" transform="translate(0, 2320)">
                        <rect x="0" y="0" width="1400" height="560" fill="#849a2e"/>

                        <text x="700" y="60" text-anchor="middle" class="hf-title" font-size="32" fill="#FFFFFF">SELECTED PROJECTS</text>

                        <g transform="translate(175, 100)">
                            
                            <!-- Project 1: Pro Health -->
                            <g transform="translate(0, 0)">
                                <rect x="0" y="0" width="320" height="390" rx="20" fill="#FFFFFF" filter="url(#soft-shadow)"/>
                                
                                <!-- Card Image Banner -->
                                <rect x="0" y="0" width="320" height="160" rx="20" fill="#1D2939"/>
                                <circle cx="160" cy="80" r="40" fill="#a8c047"/>
                                <text x="160" y="88" text-anchor="middle" class="hf-title" font-size="28" fill="#FFFFFF">+H</text>

                                <!-- Card Content -->
                                <g transform="translate(0, 160)">
                                    <rect x="0" y="0" width="320" height="230" rx="20" fill="#a8c047"/>
                                    <text x="25" y="40" class="hf-title" font-size="22" fill="#1A1A1A">PRO HEALTH</text>
                                    <text x="25" y="65" class="hf-body" font-size="14" fill="#1A1A1A">Graduation Project</text>

                                    <!-- Tags -->
                                    <g transform="translate(25, 95)">
                                        <rect x="0" y="0" width="55" height="28" rx="14" fill="#FFFFFF"/>
                                        <text x="27" y="18" text-anchor="middle" class="hf-tag-text">C++</text>

                                        <rect x="65" y="0" width="95" height="28" rx="14" fill="#FFFFFF"/>
                                        <text x="112" y="18" text-anchor="middle" class="hf-tag-text">PocketBase</text>

                                        <rect x="0" y="38" width="95" height="28" rx="14" fill="#FFFFFF"/>
                                        <text x="47" y="56" text-anchor="middle" class="hf-tag-text">Gemini API</text>

                                        <rect x="105" y="38" width="115" height="28" rx="14" fill="#FFFFFF"/>
                                        <text x="162" y="56" text-anchor="middle" class="hf-tag-text">Manual Testing</text>
                                    </g>
                                </g>
                            </g>

