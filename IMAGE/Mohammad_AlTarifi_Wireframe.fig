<svg id="wireframe-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1400 4550" width="100%" height="auto" style="background-color: #FAFAFA;">
                    <defs>
                        <!-- Grid Pattern for Blueprint Aesthetic -->
                        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#F1F5F9" stroke-width="1"/>
                        </pattern>

                        <!-- Wireframe Image Pattern (Dashed X Box) -->
                        <style>
                            .wf-title { font-family: 'Inter', sans-serif; font-weight: 700; fill: #1D2939; }
                            .wf-subtitle { font-family: 'Inter', sans-serif; font-weight: 600; fill: #475467; }
                            .wf-text { font-family: 'Inter', sans-serif; font-weight: 400; fill: #667085; }
                            .wf-mono { font-family: 'Space Mono', monospace; }
                            .wf-box { fill: #FFFFFF; stroke: #D0D5DD; stroke-width: 1.5; rx: 12px; }
                            .wf-box-dark { fill: #1D2939; rx: 12px; }
                            .wf-box-gray { fill: #F2F4F7; stroke: #EAECF0; stroke-width: 1.5; rx: 12px; }
                            .wf-tag { fill: #EAECF0; stroke: #D0D5DD; stroke-width: 1; rx: 16px; }
                            .wf-tag-text { font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 600; fill: #344054; }
                            .wf-img-placeholder { fill: #F8FAFC; stroke: #98A2B3; stroke-width: 1.5; stroke-dasharray: 6 6; rx: 12px; }
                            .wf-x-line { stroke: #D0D5DD; stroke-width: 1.5; stroke-dasharray: 4 4; }
                            .wf-badge { fill: #344054; rx: 4px; }
                            .wf-badge-text { font-family: 'Space Mono', monospace; font-size: 10px; font-weight: 700; fill: #FFFFFF; }
                        </style>
                    </defs>

                    <!-- Background Grid -->
                    <rect width="1400" height="4550" fill="url(#grid)"/>

                    <!-- ==========================================
                         1. TOP BAR MARQUEE TICKER
                         ========================================== -->
                    <g id="wf-top-bar">
                        <rect x="0" y="0" width="1400" height="40" fill="#1D2939"/>
                        <text x="700" y="25" text-anchor="middle" fill="#98A2B3" class="wf-mono" font-size="12">
                            Backend * Frontend * Database * Testing * HTML * CSS * JS * React * C# * ASP.NET * PHP * Laravel * MySQL * PostgreSQL * MongoDB
                        </text>
                        <!-- Badge Label -->
                        <rect x="20" y="10" width="130" height="20" class="wf-badge" fill="#475467"/>
                        <text x="85" y="24" text-anchor="middle" class="wf-badge-text">MARQUEE TICKER</text>
                    </g>

                    <!-- ==========================================
                         2. NAVIGATION BAR
                         ========================================== -->
                    <g id="wf-navbar" transform="translate(0, 40)">
                        <rect x="0" y="0" width="1400" height="80" fill="#FFFFFF" stroke="#EAECF0" stroke-width="1.5"/>
                        
                        <!-- Brand Logo Skeleton -->
                        <rect x="80" y="22" width="160" height="36" rx="8" fill="#1D2939"/>
                        <text x="160" y="45" text-anchor="middle" fill="#FFFFFF" class="wf-title" font-size="15">Mo Al-Tarifi</text>
                        
                        <!-- Nav Links Skeletons -->
                        <g transform="translate(750, 26)">
                            <rect x="0" y="0" width="60" height="28" rx="6" fill="#F2F4F7"/>
                            <text x="30" y="18" text-anchor="middle" class="wf-text" font-size="12">About</text>

                            <rect x="75" y="0" width="65" height="28" rx="6" fill="#F2F4F7"/>
                            <text x="107" y="18" text-anchor="middle" class="wf-text" font-size="12">Results</text>

                            <rect x="155" y="0" width="55" height="28" rx="6" fill="#F2F4F7"/>
                            <text x="182" y="18" text-anchor="middle" class="wf-text" font-size="12">Stack</text>

                            <rect x="225" y="0" width="70" height="28" rx="6" fill="#F2F4F7"/>
                            <text x="260" y="18" text-anchor="middle" class="wf-text" font-size="12">Projects</text>

                            <rect x="310" y="0" width="90" height="28" rx="6" fill="#F2F4F7"/>
                            <text x="355" y="18" text-anchor="middle" class="wf-text" font-size="12">Certificates</text>

                            <rect x="415" y="0" width="55" height="28" rx="6" fill="#F2F4F7"/>
                            <text x="442" y="18" text-anchor="middle" class="wf-text" font-size="12">Work</text>

                            <rect x="485" y="0" width="75" height="28" rx="6" fill="#1D2939"/>
                            <text x="522" y="18" text-anchor="middle" fill="#FFFFFF" class="wf-subtitle" font-size="12">Contact</text>
                        </g>

                        <!-- Badge Label -->
                        <rect x="20" y="5" width="80" height="18" class="wf-badge"/>
                        <text x="60" y="17" text-anchor="middle" class="wf-badge-text">NAVBAR</text>
                    </g>

                    <!-- ==========================================
                         3. HERO / ABOUT SECTION
                         ========================================== -->
                    <g id="wf-about" transform="translate(80, 160)">
                        <!-- Main Card Outer Container -->
                        <rect x="0" y="0" width="1240" height="580" class="wf-box-gray" rx="24"/>

                        <!-- Badge Label -->
                        <rect x="20" y="20" width="150" height="22" class="wf-badge"/>
                        <text x="95" y="35" text-anchor="middle" class="wf-badge-text">HERO &amp; ABOUT SECTION</text>

                        <!-- Left Column: Info & Content -->
                        <g transform="translate(50, 60)">
                            <!-- Name Title -->
                            <rect x="0" y="0" width="380" height="42" rx="8" fill="#1D2939"/>
                            <text x="20" y="27" fill="#FFFFFF" class="wf-title" font-size="24">Mohammad Al-Tarifi</text>

                            <!-- Role Subtitle -->
                            <rect x="0" y="54" width="220" height="26" rx="6" fill="#475467"/>
                            <text x="15" y="72" fill="#FFFFFF" class="wf-subtitle" font-size="14">Software Engineer</text>

                            <!-- Tagline -->
                            <text x="0" y="115" class="wf-mono" font-weight="700" font-size="15" fill="#1D2939">Building ideas. Writing code. Solving problems.</text>

                            <!-- Description Text Skeleton Blocks -->
                            <rect x="0" y="135" width="560" height="12" rx="3" fill="#D0D5DD"/>
                            <rect x="0" y="155" width="540" height="12" rx="3" fill="#D0D5DD"/>
                            <rect x="0" y="175" width="500" height="12" rx="3" fill="#D0D5DD"/>
                            <rect x="0" y="195" width="420" height="12" rx="3" fill="#D0D5DD"/>

                            <!-- Field Cards (3 Grid Items) -->
                            <text x="0" y="240" class="wf-title" font-size="14" fill="#1D2939">MY FIELDS</text>
                            
                            <g transform="translate(0, 255)">
                                <!-- Field 1 -->
                                <rect x="0" y="0" width="175" height="100" class="wf-box"/>
                                <text x="15" y="30" class="wf-title" font-size="13">Web Dev</text>
                                <rect x="15" y="45" width="140" height="8" rx="2" fill="#D0D5DD"/>
                                <rect x="15" y="60" width="110" height="8" rx="2" fill="#D0D5DD"/>

                                <!-- Field 2 -->
                                <rect x="190" y="0" width="175" height="100" class="wf-box"/>
                                <text x="205" y="30" class="wf-title" font-size="13">Software Eng.</text>
                                <rect x="205" y="45" width="140" height="8" rx="2" fill="#D0D5DD"/>
                                <rect x="205" y="60" width="120" height="8" rx="2" fill="#D0D5DD"/>

                                <!-- Field 3 -->
                                <rect x="380" y="0" width="175" height="100" class="wf-box"/>
                                <text x="395" y="30" class="wf-title" font-size="13">QA &amp; Testing</text>
                                <rect x="395" y="45" width="140" height="8" rx="2" fill="#D0D5DD"/>
                                <rect x="395" y="60" width="100" height="8" rx="2" fill="#D0D5DD"/>
                            </g>

                            <!-- CTA Button -->
                            <g transform="translate(0, 385)">
                                <rect x="0" y="0" width="200" height="48" rx="24" fill="#1D2939"/>
                                <text x="100" y="28" text-anchor="middle" fill="#FFFFFF" class="wf-subtitle" font-size="13">Explore My Work ↓</text>
                            </g>
                        </g>

                        <!-- Right Column: Image Placeholder with Shadow Offset -->
                        <g transform="translate(740, 70)">
                            <!-- Shadow Offset Box -->
                            <rect x="20" y="20" width="380" height="440" rx="20" fill="#1D2939"/>
                            
                            <!-- Main Placeholder Box -->
                            <rect x="0" y="0" width="380" height="440" class="wf-img-placeholder" fill="#FFFFFF"/>
                            
                            <!-- Crossed X Lines for Image Placeholder -->
                            <line x1="0" y1="0" x2="380" y2="440" class="wf-x-line"/>
                            <line x1="380" y1="0" x2="0" y2="440" class="wf-x-line"/>

                            <!-- Icon & Label Center Overlay -->
                            <rect x="90" y="195" width="200" height="50" rx="10" fill="#1D2939"/>
                            <text x="190" y="225" text-anchor="middle" fill="#FFFFFF" class="wf-mono" font-size="13">[ PORTRAIT PHOTO ]</text>
                        </g>
                    </g>

                    <!-- ==========================================
                         4. RESULTS / METRICS SECTION
                         ========================================== -->
                    <g id="wf-results" transform="translate(80, 780)">
                        <rect x="0" y="0" width="1240" height="380" class="wf-box-gray" rx="24"/>

                        <rect x="20" y="20" width="130" height="22" class="wf-badge"/>
                        <text x="85" y="35" text-anchor="middle" class="wf-badge-text">METRICS GRID</text>

                        <!-- Section Title -->
                        <text x="50" y="70" class="wf-title" font-size="28">RESULTS</text>
                        <text x="50" y="95" class="wf-text" font-size="14">Measurable improvements through practical work.</text>

                        <!-- 2x2 Grid for Results -->
                        <g transform="translate(50, 120)">
                            <!-- Metric 1 -->
                            <g transform="translate(0, 0)">
                                <rect x="0" y="0" width="550" height="100" class="wf-box" stroke-dasharray="0" stroke-width="2"/>
                                <rect x="0" y="0" width="8" height="100" fill="#1D2939" rx="4"/>
                                <text x="30" y="40" class="wf-title" font-size="15">TEST COVERAGE</text>
                                <text x="30" y="65" class="wf-text" font-size="13">Better testing coverage</text>
                                
                                <rect x="340" y="30" width="60" height="40" rx="8" fill="#EAECF0"/>
                                <text x="370" y="55" text-anchor="middle" class="wf-mono" font-weight="700" fill="#98A2B3" font-size="15">12%</text>
                                <text x="425" y="55" text-anchor="middle" font-size="20" fill="#475467">→</text>
                                <rect x="450" y="25" width="70" height="50" rx="10" fill="#1D2939"/>
                                <text x="485" y="56" text-anchor="middle" class="wf-mono" font-weight="700" fill="#FFFFFF" font-size="18">94%</text>
                            </g>

                            <!-- Metric 2 -->
                            <g transform="translate(590, 0)">
                                <rect x="0" y="0" width="550" height="100" class="wf-box"/>
                                <rect x="0" y="0" width="8" height="100" fill="#1D2939" rx="4"/>
                                <text x="30" y="40" class="wf-title" font-size="15">RELEASES PER MONTH</text>
                                <text x="30" y="65" class="wf-text" font-size="13">More frequent releases</text>
                                
                                <rect x="360" y="30" width="40" height="40" rx="8" fill="#EAECF0"/>
                                <text x="380" y="55" text-anchor="middle" class="wf-mono" font-weight="700" fill="#98A2B3" font-size="15">1</text>
                                <text x="425" y="55" text-anchor="middle" font-size="20" fill="#475467">→</text>
                                <rect x="450" y="25" width="70" height="50" rx="10" fill="#1D2939"/>
                                <text x="485" y="56" text-anchor="middle" class="wf-mono" font-weight="700" fill="#FFFFFF" font-size="18">8</text>
                            </g>

                            <!-- Metric 3 -->
                            <g transform="translate(0, 120)">
                                <rect x="0" y="0" width="550" height="100" class="wf-box"/>
                                <rect x="0" y="0" width="8" height="100" fill="#1D2939" rx="4"/>
                                <text x="30" y="40" class="wf-title" font-size="15">PROD BUGS / MONTH</text>
                                <text x="30" y="65" class="wf-text" font-size="13">Fewer production bugs</text>
                                
                                <rect x="340" y="30" width="60" height="40" rx="8" fill="#EAECF0"/>
                                <text x="370" y="55" text-anchor="middle" class="wf-mono" font-weight="700" fill="#98A2B3" font-size="15">47</text>
                                <text x="425" y="55" text-anchor="middle" font-size="20" fill="#475467">→</text>
                                <rect x="450" y="25" width="70" height="50" rx="10" fill="#1D2939"/>
                                <text x="485" y="56" text-anchor="middle" class="wf-mono" font-weight="700" fill="#FFFFFF" font-size="18">3</text>
                            </g>

                            <!-- Metric 4 -->
                            <g transform="translate(590, 120)">
                                <rect x="0" y="0" width="550" height="100" class="wf-box"/>
                                <rect x="0" y="0" width="8" height="100" fill="#1D2939" rx="4"/>
                                <text x="30" y="40" class="wf-title" font-size="15">PAGE LOAD TIME</text>
                                <text x="30" y="65" class="wf-text" font-size="13">Faster page loading</text>
                                
                                <rect x="330" y="30" width="70" height="40" rx="8" fill="#EAECF0"/>
                                <text x="365" y="55" text-anchor="middle" class="wf-mono" font-weight="700" fill="#98A2B3" font-size="15">4.8s</text>
                                <text x="425" y="55" text-anchor="middle" font-size="20" fill="#475467">→</text>
                                <rect x="450" y="25" width="70" height="50" rx="10" fill="#1D2939"/>
                                <text x="485" y="56" text-anchor="middle" class="wf-mono" font-weight="700" fill="#FFFFFF" font-size="18">0.9s</text>
                            </g>
                        </g>
                    </g>

                    <!-- ==========================================
                         5. MARKETING DESIGN BANNER
                         ========================================== -->
                    <g id="wf-banner" transform="translate(80, 1200)">
                        <rect x="0" y="0" width="1240" height="340" fill="#1D2939" rx="24"/>

                        <rect x="20" y="20" width="160" height="22" class="wf-badge" fill="#475467"/>
                        <text x="100" y="35" text-anchor="middle" class="wf-badge-text">TYPOGRAPHY BANNER</text>

                        <!-- Big Headline Blocks -->
                        <g transform="translate(60, 60)">
                            <text x="0" y="35" fill="#FFFFFF" class="wf-mono" font-weight="700" font-size="36">I BUILD</text>

                            <rect x="180" y="2" width="160" height="42" rx="6" fill="#EAECF0"/>
                            <text x="260" y="32" text-anchor="middle" fill="#1D2939" class="wf-mono" font-weight="700" font-size="30">FRONT.</text>

                            <text x="0" y="85" fill="#FFFFFF" class="wf-mono" font-weight="700" font-size="36">I BUILD</text>

                            <rect x="180" y="52" width="140" height="42" rx="6" fill="#D0D5DD"/>
                            <text x="250" y="82" text-anchor="middle" fill="#1D2939" class="wf-mono" font-weight="700" font-size="30">BACK.</text>

                            <text x="0" y="135" fill="#FFFFFF" class="wf-mono" font-weight="700" font-size="36">I TEST</text>

                            <rect x="150" y="102" width="270" height="42" rx="6" fill="#98A2B3"/>
                            <text x="285" y="132" text-anchor="middle" fill="#1D2939" class="wf-mono" font-weight="700" font-size="30">EVERYTHING.</text>
                        </g>

                        <!-- Paragraph Side Box -->
                        <g transform="translate(660, 80)">
                            <rect x="0" y="0" width="520" height="170" rx="16" fill="#344054"/>
                            <text x="30" y="40" fill="#EAECF0" class="wf-mono" font-size="12">Full-stack &amp; QA Integration Philosophy:</text>
                            
                            <rect x="30" y="60" width="460" height="8" rx="2" fill="#98A2B3"/>
                            <rect x="30" y="80" width="440" height="8" rx="2" fill="#98A2B3"/>
                            <rect x="30" y="100" width="410" height="8" rx="2" fill="#98A2B3"/>
                            <rect x="30" y="120" width="350" height="8" rx="2" fill="#98A2B3"/>
                        </g>
                    </g>

                    <!-- ==========================================
                         6. TECH STACK SECTION
                         ========================================== -->
                    <g id="wf-stack" transform="translate(80, 1580)">
                        <rect x="0" y="0" width="1240" height="520" class="wf-box-gray" rx="24"/>

                        <rect x="20" y="20" width="130" height="22" class="wf-badge"/>
                        <text x="85" y="35" text-anchor="middle" class="wf-badge-text">TECH MATRIX</text>

                        <text x="620" y="70" text-anchor="middle" class="wf-title" font-size="28">WHAT I WORK WITH</text>

                        <g transform="translate(50, 100)">
                            <!-- Box 1: Frontend -->
                            <g transform="translate(0, 0)">
                                <rect x="0" y="0" width="550" height="180" fill="#1D2939" rx="16"/>
                                <text x="30" y="40" fill="#FFFFFF" class="wf-title" font-size="18">FRONTEND</text>
                                <line x1="30" y1="52" x2="520" y2="52" stroke="#475467" stroke-width="1.5" stroke-dasharray="4 4"/>
                                
                                <rect x="30" y="70" width="460" height="8" rx="2" fill="#98A2B3"/>
                                <rect x="30" y="88" width="380" height="8" rx="2" fill="#98A2B3"/>

                                <!-- Tags -->
                                <g transform="translate(30, 120)">
                                    <rect x="0" y="0" width="70" height="28" class="wf-tag" fill="#FFFFFF"/>
                                    <text x="35" y="18" text-anchor="middle" class="wf-tag-text">HTML</text>

                                    <rect x="80" y="0" width="60" height="28" class="wf-tag" fill="#FFFFFF"/>
                                    <text x="110" y="18" text-anchor="middle" class="wf-tag-text">CSS</text>

                                    <rect x="150" y="0" width="100" height="28" class="wf-tag" fill="#FFFFFF"/>
                                    <text x="200" y="18" text-anchor="middle" class="wf-tag-text">JavaScript</text>

                                    <rect x="260" y="0" width="70" height="28" class="wf-tag" fill="#FFFFFF"/>
                                    <text x="295" y="18" text-anchor="middle" class="wf-tag-text">React</text>
                                </g>
                            </g>

                            <!-- Box 2: Backend -->
                            <g transform="translate(590, 0)">
                                <rect x="0" y="0" width="550" height="180" class="wf-box"/>
                                <text x="30" y="40" class="wf-title" font-size="18">BACKEND</text>
                                <line x1="30" y1="52" x2="520" y2="52" stroke="#EAECF0" stroke-width="1.5" stroke-dasharray="4 4"/>
                                
                                <rect x="30" y="70" width="440" height="8" rx="2" fill="#D0D5DD"/>
                                <rect x="30" y="88" width="360" height="8" rx="2" fill="#D0D5DD"/>

                                <g transform="translate(30, 120)">
                                    <rect x="0" y="0" width="50" height="28" class="wf-tag"/>
                                    <text x="25" y="18" text-anchor="middle" class="wf-tag-text">C#</text>

                                    <rect x="60" y="0" width="90" height="28" class="wf-tag"/>
                                    <text x="105" y="18" text-anchor="middle" class="wf-tag-text">ASP.NET</text>

                                    <rect x="160" y="0" width="60" height="28" class="wf-tag"/>
                                    <text x="190" y="18" text-anchor="middle" class="wf-tag-text">PHP</text>

                                    <rect x="230" y="0" width="80" height="28" class="wf-tag"/>
                                    <text x="270" y="18" text-anchor="middle" class="wf-tag-text">Laravel</text>
                                </g>
                            </g>

                            <!-- Box 3: QA -->
                            <g transform="translate(0, 200)">
                                <rect x="0" y="0" width="550" height="180" class="wf-box"/>
                                <text x="30" y="40" class="wf-title" font-size="18">QUALITY ASSURANCE</text>
                                <line x1="30" y1="52" x2="520" y2="52" stroke="#EAECF0" stroke-width="1.5" stroke-dasharray="4 4"/>
                                
                                <rect x="30" y="70" width="460" height="8" rx="2" fill="#D0D5DD"/>
                                <rect x="30" y="88" width="390" height="8" rx="2" fill="#D0D5DD"/>

                                <g transform="translate(30, 120)">
                                    <rect x="0" y="0" width="120" height="28" class="wf-tag"/>
                                    <text x="60" y="18" text-anchor="middle" class="wf-tag-text">Manual Testing</text>

                                    <rect x="130" y="0" width="90" height="28" class="wf-tag"/>
                                    <text x="175" y="18" text-anchor="middle" class="wf-tag-text">Test Cases</text>

                                    <rect x="230" y="0" width="110" height="28" class="wf-tag"/>
                                    <text x="285" y="18" text-anchor="middle" class="wf-tag-text">Bug Reporting</text>
                                </g>
                            </g>

                            <!-- Box 4: Database -->
                            <g transform="translate(590, 200)">
                                <rect x="0" y="0" width="550" height="180" fill="#1D2939" rx="16"/>
                                <text x="30" y="40" fill="#FFFFFF" class="wf-title" font-size="18">DATABASE</text>
                                <line x1="30" y1="52" x2="520" y2="52" stroke="#475467" stroke-width="1.5" stroke-dasharray="4 4"/>
                                
                                <rect x="30" y="70" width="450" height="8" rx="2" fill="#98A2B3"/>
                                <rect x="30" y="88" width="370" height="8" rx="2" fill="#98A2B3"/>

                                <g transform="translate(30, 120)">
                                    <rect x="0" y="0" width="60" height="28" class="wf-tag" fill="#FFFFFF"/>
                                    <text x="30" y="18" text-anchor="middle" class="wf-tag-text">SQL</text>

                                    <rect x="70" y="0" width="75" height="28" class="wf-tag" fill="#FFFFFF"/>
                                    <text x="107" y="18" text-anchor="middle" class="wf-tag-text">MySQL</text>

                                    <rect x="155" y="0" width="105" height="28" class="wf-tag" fill="#FFFFFF"/>
                                    <text x="207" y="18" text-anchor="middle" class="wf-tag-text">PostgreSQL</text>

                                    <rect x="270" y="0" width="90" height="28" class="wf-tag" fill="#FFFFFF"/>
                                    <text x="315" y="18" text-anchor="middle" class="wf-tag-text">MongoDB</text>
                                </g>
                            </g>
                        </g>
                    </g>

                    <!-- ==========================================
                         7. SELECTED PROJECTS SECTION
                         ========================================== -->
                    <g id="wf-projects" transform="translate(80, 2140)">
                        <rect x="0" y="0" width="1240" height="580" fill="#344054" rx="24"/>

                        <rect x="20" y="20" width="150" height="22" class="wf-badge" fill="#1D2939"/>
                        <text x="95" y="35" text-anchor="middle" class="wf-badge-text">PROJECTS GALLERY</text>

                        <text x="620" y="70" text-anchor="middle" fill="#FFFFFF" class="wf-title" font-size="28">SELECTED PROJECTS</text>

                        <g transform="translate(50, 100)">
                            <!-- Project Card 1: Pro Health -->
                            <g transform="translate(0, 0)">
                                <rect x="0" y="0" width="360" height="420" class="wf-box"/>
                                
                                <!-- Image Placeholder -->
                                <rect x="0" y="0" width="360" height="180" class="wf-img-placeholder"/>
                                <line x1="0" y1="0" x2="360" y2="180" class="wf-x-line"/>
                                <line x1="360" y1="0" x2="0" y2="180" class="wf-x-line"/>
